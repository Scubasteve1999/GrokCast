#!/bin/bash

# grok-build
# A lightweight local CLI for common DayCast development tasks.
# Usage: ./grok-build <command>

set -e

COMMAND=${1:-help}

case $COMMAND in
  increment-build)
    echo "🔢 Running build number increment..."
    shift
    ./Scripts/increment_build.sh "$@"
    ;;
  
  regenerate)
    echo "🔄 Regenerating Xcode project..."
    shift
    if [[ "$1" == "--force" ]]; then
        echo "🧹 Force mode: removing existing .xcodeproj..."
        rm -rf DayCast.xcodeproj
    fi
    /opt/homebrew/bin/xcodegen generate --spec project.yml
    echo "✅ Project regenerated."
    ;;

  generate-icons)
    echo "🎨 Generating App Icons..."
    shift
    ./Scripts/generate_app_icons.sh "$@"
    ;;

  clean)
    shift
    CLEAN_DERIVED=false
    CLEAN_SIM=false

    while [[ $# -gt 0 ]]; do
      case $1 in
        --derived-data)
          CLEAN_DERIVED=true
          shift
          ;;
        --simulator)
          CLEAN_SIM=true
          shift
          ;;
        --deep)
          CLEAN_DERIVED=true
          CLEAN_SIM=true
          shift
          ;;
        *)
          echo "Unknown option for clean: $1"
          exit 1
          ;;
      esac
    done

    if ! $CLEAN_DERIVED && ! $CLEAN_SIM; then
      # Default: clean derived data only (safe default)
      CLEAN_DERIVED=true
    fi

    echo "🧹 Running clean for DayCast..."

    if $CLEAN_DERIVED; then
      echo "→ Removing DayCast DerivedData..."
      rm -rf ~/Library/Developer/Xcode/DerivedData/DayCast-* 2>/dev/null || true
      echo "   DerivedData cleaned."
    fi

    if $CLEAN_SIM; then
      echo ""
      echo "⚠️  WARNING: This will ERASE ALL content and settings from EVERY iOS Simulator."
      read -p "Are you sure you want to continue? (y/N) " -n 1 -r
      echo
      if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "→ Erasing all simulators..."
        xcrun simctl erase all
        echo "   Simulators erased."
      else
        echo "   Simulator erase cancelled."
      fi
    fi

    echo ""
    echo "✅ Clean complete."
    ;;

  archive)
    echo "📦 Creating Release archive for TestFlight..."
    shift
    INCREMENT_FLAG=""
    if [[ "${1:-}" == "--increment" ]]; then
      INCREMENT_FLAG="--increment"
    fi
    chmod +x ./Scripts/archive_for_testflight.sh
    ./Scripts/archive_for_testflight.sh $INCREMENT_FLAG
    ;;

  capture-aso)
    echo "📸 Capturing App Store screenshot compositions..."
    shift
    chmod +x ./Scripts/capture_aso_screenshots.sh
    ./Scripts/capture_aso_screenshots.sh "$@"
    ;;

  help|*)
    echo "DayCast Build Helper"
    echo ""
    echo "Usage: ./grok-build <command> [options]"
    echo ""
    echo "Available commands:"
    echo "  increment-build [--tag]     Bump the Xcode build number"
    echo "  regenerate [--force]        Regenerate the Xcode project from project.yml"
    echo "  generate-icons <1024.png>   Generate all iOS app icon sizes from a 1024x1024 source"
    echo "  clean [--deep]              Clean DerivedData (use --deep for full reset)"
    echo "  archive [--increment]       Release archive → build/DayCast.xcarchive (TestFlight prep)"
    echo "  capture-aso                 Simulator screenshots → Marketing/AppStore/"
    echo "  help                        Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./grok-build regenerate"
    echo "  ./grok-build regenerate --force"
    echo "  ./grok-build increment-build --tag"
    echo "  ./grok-build generate-icons ~/Desktop/my-icon-1024.png"
    echo "  ./grok-build clean              # Safe: only clears DerivedData"
    echo "  ./grok-build clean --deep       # Full reset (DerivedData + Simulator)"
    ;;
esac
