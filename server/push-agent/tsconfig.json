{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // `node` is here for the test files only — the pure modules under test run in
    // both runtimes, which is what lets `node --test` cover them without miniflare.
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping (`node --test` on .ts) and the Agents SDK both require
    // erasable-only syntax. This also keeps `@callable`-style TC39 decorators intact —
    // experimentalDecorators would silently break them.
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
