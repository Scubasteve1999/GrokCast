# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode - .xcodeproj
# !*.xcodeproj
# *.xcodeproj/*
# !*.xcodeproj/project.pbxproj
# !*.xcodeproj/xcshareddata/
# !*.xcodeproj/project.xcworkspace/
# *.xcodeproj/project.xcworkspace/xcuserdata/

# Xcode - .xcworkspace (CocoaPods, etc.)
*.xcworkspace
!default.xcworkspace

# Xcode Cloud needs the pinned SPM manifest committed (resolves mapbox-maps-ios).
# Re-include the workspace dir chain so git can descend into it; the file itself
# is un-ignored below, after the broad `Package.resolved` rule that would re-ignore it.
!DayCast.xcodeproj/project.xcworkspace/
!DayCast.xcodeproj/project.xcworkspace/xcshareddata/
!DayCast.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
# ...but keep the user-specific workspace settings the re-inclusion above exposes ignored
DayCast.xcodeproj/project.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Swift Package Manager
.build/
Packages/
Package.resolved
!DayCast.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.swiftpm

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/

# ==========================================
# Secrets & API Keys - NEVER COMMIT THESE
# ==========================================

# xAI / Grok API Keys and configuration files containing secrets
GrokConfig.swift
Secrets.swift
DayCast/Config/Secrets.swift
DayCast/Config/DeveloperAPIKey.swift
DayCast/Config/OpenWeatherMapKeys.swift
# Do NOT ignore DayCast/Config/ wholesale — that prevents re-including
# *.example templates and the Firebase client plist (see below).
*.key
*.pem
*.p8
.env
.env.local
.env.*.local

# GoogleService-Info.plist is Firebase *client* config. It ships inside the app
# binary and is not a server secret. Committing it removes the fragile
# GOOGLE_SERVICE_INFO_PLIST_BASE64 Xcode Cloud env var (ASC paste/mask bugs).

# Do NOT ignore our safe public configuration file
!GrokAPIConfiguration.swift
!Shared/Configuration/GrokAPIConfiguration.swift

# Allow example templates (safe to commit with placeholders)
!GrokConfig.swift.example
!Secrets.swift.example
!DayCast/Config/Secrets.swift.example
!DayCast/Config/DeveloperAPIKey.swift.example
!DayCast/Config/OpenWeatherMapKeys.swift.example
!GrokAPIConfiguration.swift.example
!Shared/Configuration/GrokAPIConfiguration.swift.example

# Any file that might accidentally contain an API key
*api-key*
*secret*
*credentials*

# ==========================================
# macOS / General
# ==========================================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ==========================================
# Project Specific
# ==========================================

# Local development overrides
Debug.xcconfig
*.local

# PostHog / build secrets (Shared.xcconfig is safe; Secrets.xcconfig is not)
Config/Secrets.xcconfig
# *secret* also matches the example — keep the template tracked
!Config/Secrets.xcconfig.example
!Secrets.xcconfig.example

# Build artifacts we don't want in git
build/
DerivedData*
.derived-data-log-*
*.o
*.a
*.so
*.xcarchive/
*.mov
.video-frames*/
DayCast */

# Grok Build session artifacts (local review/summary notes)
grok-impl-summary-*.md
review-*.md
rereview-*.md

# Logs
*.log
logs/

# Local agent tooling config (machine-specific paths / simulator UDIDs)
.xcodebuildmcp/

# Local QA scratch: screenshots, smoke-test runs, verification artifacts
scratch/

# Cloudflare Wrangler local cache (account email / IDs — do not commit)
.wrangler/

# App Store Connect API key (never commit)
fastlane/AuthKey_*.p8
fastlane/asc_api_key.json
fastlane/metadata/review_information/
fastlane/Preview.html

# One-off App Store Connect review-submission scripts (hardcoded per-build IDs; disposable)
Scripts/submit_app_review_*.py
