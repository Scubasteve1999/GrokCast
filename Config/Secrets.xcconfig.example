// Copy to Secrets.xcconfig (gitignored) and fill in:
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// PostHog Project API key (phc_...) from https://us.posthog.com/settings/project-details
// Use a dedicated DayCast project (not DataCentral) so metrics stay separate.
// Public client key — safe in the app binary; required for funnel events to leave the device.
POSTHOG_API_KEY = your_posthog_project_api_key_here
